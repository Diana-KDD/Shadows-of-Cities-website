@* Views/Admin/Index.cshtml *@
@model List<WebsiteProgect.Models.Place>
@{
    ViewData["Title"] = "Выбор действий для админа";
}

<a href="/Places/Index">Вернуться в каталог</a>

@if (Model.Count == 0)
{
    <a href="/Admin/AddPlace">Добавить первое место</a>
}
else
{
    <div class="catalog">
        @foreach (var place in Model)
        {
            <div class="card">
                @if (place.Images != null && place.Images.Any())
                {
                    <img src="@place.Images.FirstOrDefault(i => i.IsPrimary == 1)?.ImagePath"
                         alt="@place.Name" />
                }
                else
                {
                    <div class="no-photo">Нет фото</div>
                }
                <h2>@place.Name</h2>
                <p>@place.City?.Country?.Name, @place.City?.Name</p>
                <a href="/Admin/Change">Изменить</a>
                <a href="/Admin/Delete/@place.Id">Удалить</a>
            </div>
        }
    </div>
    <a href="/Admin/Add">Добавить место</a>
}