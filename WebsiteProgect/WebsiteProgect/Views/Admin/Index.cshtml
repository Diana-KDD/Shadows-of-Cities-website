@* Views/Admin/Index.cshtml *@
@model List<WebsiteProgect.Models.Place>
@{}

<!DOCTYPE html>
<html>
<head>
    <title>Админка</title>
    <link rel="stylesheet" href="/css/styleAdminIndex.css" />
</head>
<body>
    <h1 class="website-title">Редактор</h1>
    <h2 class="website-name">Тени городов</h2>

    <hr/>

    <button class="back">Вернуться в каталог</button>

    <div class="btnsEdit">
        <button class="categoryChange">Редактировать категории</button>
        <button class="countryChange">Редактировать страны</button>
        <button class="cityChange">Редактировать города</button>
    </div>

    <div class="modalUpdate"><div class="content"><div class="box"></div></div></div>

    @if (Model.Count == 0)
    {
        <p class="text">Мест нет. Добавьте.</p>
        <button class="placeAdd">Добавить место</button>
        <hr />
    }
    else
    {
        <button class="placeAdd">Добавить место</button>
        <hr />
        <table>
            <thead>
                <tr>
                    <th>Фото</th>
                    <th>Название</th>
                    <th>Категория</th>
                    <th>Расположение</th>
                    <th>Действия</th>
                    <th>Последнее изменение</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var place in Model)
                {
                    <tr>
                        <td>
                            @if (place.Images != null && place.Images.Any())
                            {
                                <img src="@place.Images.FirstOrDefault(i => i.IsPrimary == true)?.ImagePath"
                                     alt="@place.Name" />
                            }
                            else
                            {
                                <div class="no-photo">Нет фото</div>
                            }
                        </td>
                        <td>@place.Name</td>
                        <td>Категория</td>
                        @if (@place.City?.Country?.Name != null && @place.City?.Name != null)
                        {
                            <td> 
                                <p>@place.City?.Country?.Name</p>
                                <p>@place.City?.Name</p>
                            </td>
                        }
                        else
                        {
                            <td> - </td>
                        }
                        <td>
                            <div class="btnsAction">
                                <button class="placeChange" data-id="@place.Id">Изменить</button>
                                <button class="btnDelete" data-id="@place.Id">Удалить</button>
                            </div>
                        </td>
                        <td> Дата </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <script src="/js/dataConfig.js"></script>
    <script src="/js/adminIndexMain.js"></script>
</body>
</html>

