@model WebsiteProgect.Models.Place
@{
}

<!DOCTYPE html>
<html>
<head>
    <title>Изменить "@Model.Name"</title>
    <link rel="stylesheet" href="/css/styleAdminCreate.css" />
</head>
<body>
    <h1>Изменить: @Model.Name</h1>

    <form asp-action="Change" method="post" enctype="multipart/form-data">
        <div class="firstPart">
            <!-- Основная информация -->
            <fieldset>
                <legend>Основная информация</legend>

                <label for="name">Название</label>
                <input type="text"
                       id="name"
                       name="Name"
                       autocomplete="off"
                       minlength="2"
                       maxlength="50"
                       placeholder="Например: Центральный парк"
                       required
                       value="@Model.Name">

                <label for="category">Категория</label>
                <select name="CategoryId" id="category">
                    <option value="">-- Выберите категорию --</option>
                    @foreach (var category in ViewBag.Categories)
                    {
                        <option value="@category.Id" selected="@(category.Id == Model.CategoryId ? "selected" : null)">@category.Name</option>
                    }
                </select>

                <label for="description">Описание</label>
                <textarea id="description"
                          name="Description"
                          rows="4"
                          maxlength="2000"
                          placeholder="Опишите место подробно..."
                          required>@Model.Description</textarea>

                <label for="history">История</label>
                <textarea id="history"
                          name="History"
                          rows="4"
                          maxlength="2000"
                          placeholder="Исторические факты о месте..."
                          >@Model.History</textarea>
            </fieldset>

            <!-- География -->
            <fieldset>
                <legend>География</legend>

                <label for="country">Страна</label>
                <select id="country">
                    <option value="">-- Выберите страну --</option>
                    @foreach (var country in ViewBag.Countries)
                    {
                        <option value="@country.Id" selected="@(country.Id == Model.City?.CountryId ? "selected" : null)">@country.Name</option>
                    }
                </select>

                <label for="city">Город</label>
                <select name="CityId" id="city" disabled>
                    <option value="">-- Сначала выберите страну --</option>
                    <!-- Опции -->
                </select>
                <input type="hidden" name="cityId" value="@Model.CityId" id="cityId" />
            </fieldset>

            <!-- Временные данные -->
            <fieldset>
                <legend>Временной период</legend>

                <label for="yearClosure">Год закрытия</label>
                <input type="number"
                       id="yearClosure"
                       name="YearClosure"
                       min="1000"
                       max="2100"
                       step="1"
                       placeholder="Например: 2020"
                       value="@Model.YearClosure">
                <small>Оставьте пустым, если место всё ещё работает</small>
            </fieldset>

        </div>
        <div class="secondPart">
            <!-- Медиа -->
            <fieldset>
                <legend>Фотографии</legend>

                <label for="image">Добавьте фото</label>
                <input type="file"
                       name="Image"
                       id="image"
                       accept="image/jpeg, image/png, image/webp"
                       multiple>
                <small>Можно загрузить до 7 фото. Поддерживаются форматы: JPEG, PNG, WebP</small>
                <div class="imageContainer"></div>
            </fieldset>
        </div>

        <div role="group" label="Действия с формой">
            <button type="button" class="cancel">Отмена</button>
            <button type="submit">Сохранить изменения</button>
        </div>

    </form>

    <div class="modalWindow"><div class="box"></div></div>

    <script>
        // Передаём существующие фото из модели в JS
        var existingImages = [
            @foreach (var image in Model.Images)
            {
                    <text>
                    {
                        id: @image.Id,
                        name: "@image.ImageName",
                        path: "@image.ImagePath"
                    },
                    </text>
            }
        ];
    </script>
    <script src="/js/adminCommon.js"></script>
    <script src="/js/adminChange.js"></script>
</body>
</html>
