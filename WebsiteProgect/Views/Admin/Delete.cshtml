@* Views/Admin/Delete.cshtml *@
@model WebsiteProgect.Models.Place
@{}

<!DOCTYPE html>
<html>
<head>
    <title>Удаление места</title>
    <link rel="stylesheet" href="/css/styleAdminDelete.css" />
</head>
<body>
    <h2>Вы уверены, что хотите удалить это место?</h2>

    <div class="confirm-box">

        @if (@Model.Images != null && @Model.Images.Any())
        {
            <img src="@Model.Images.FirstOrDefault(i => i.IsPrimary == true)?.ImagePath"
                 alt="@Model.Name" />
        }

        <h2>Название: @Model.Name</h2>
        @if (@Model.City!=null)
        {
            <p>@Model.City?.Country?.Name</p>
            <p>@Model.City?.Name</p>
        }
        <p><strong>Категория:</strong> @Model.Category?.Name</p>
    </div>

    <form action="Delete" method="post">
        <!-- Скрытое поле для передачи id -->
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="button" class="cancel">Отмена</button>
        <button type="submit">Удалить</button>
    </form>

    <script src="~/js/AdminDelete.js"></script>
</body>
</html>