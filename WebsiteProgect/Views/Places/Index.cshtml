@* Views/Places/Index.cshtml *@
@model List<WebsiteProgect.Models.Place>
@{}

<!DOCTYPE html>
<html>
<head>
    <title>Каталог мест</title>
    <link rel="stylesheet" href="/css/stylePlaceIndex.css" />
</head>
    <body>

        <h1 class="website-title">Каталог мест</h1>
        <h2 class="website-name">Тени городов</h2>

        <hr />

        @if (Model.Count == 0)
        {
            <p>Список пуст. Добавьте первое место через админку.</p>
        }
        else
        {
            <div class="catalog">
                @foreach (var place in Model)
                {
                    <div class="card">
                        @if (place.Images != null && place.Images.Any())
                        {
                            <img src="@place.Images.FirstOrDefault(i => i.IsPrimary)?.ImagePath"
                                 alt="@place.Name" />
                        }
                        else
                        {
                            <div class="no-photo">Нет фото</div>
                        }
                        <h2>@place.Name</h2>
                        <p>@place.Category?.Name</p>
                        <p>@place.City?.Country?.Name</p>
                        <p>@place.City?.Name</p>
                        <a href="/Places/Details/@place.Id">Подробнее</a>
                    </div>
                }
            </div>
        }

        <hr />
        <img class="fon" src="/uploads/web/fon.png" alt="" />

    </body>
</html>